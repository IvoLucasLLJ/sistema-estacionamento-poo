@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 5
skinparam monochrome false
skinparam ArrowColor #364854
skinparam ClassBackgroundColor #F3F6F7
skinparam ClassBorderColor #526873
skinparam stereotypeFontColor #324B54
skinparam classAttributeIconSize 0
skinparam ParticipantBackgroundColor #EEF3F3
skinparam SequenceLifeLineBorderColor #788A92
hide circle
hide empty members
class ControleTema {
 -sistema
 -preferencia
 +constructor()
 -validar(valor)
 -aplicar()
 +conectar()
}
class ControleSubmissao {
 -enviando
 +constructor(formulario)
}
class MediaQueryList <<Web API>>
class HTMLFormElement <<DOM>>
ControleTema --> MediaQueryList : acompanha mudanças
ControleSubmissao ..> HTMLFormElement : registra ouvintes
note bottom of ControleTema
Campos privados JavaScript usam #.
move.tema armazena a escolha visual.
end note
@enduml
